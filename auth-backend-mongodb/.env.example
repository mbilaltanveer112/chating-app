# Server port (Render/Railway inject PORT automatically)
PORT=8080

# MongoDB Atlas connection string (100% free M0 cluster works)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pulsechat_auth

# Firebase Admin SDK service account JSON (single-line JSON or base64-encoded JSON)
# Firebase Console -> Project gen-lang-client-0547049184 -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional CORS origins (comma-separated, leave empty for mobile API clients)
ALLOWED_ORIGINS=

# Optional SMTP credentials for password reset emails (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PulseChat Security <no-reply@pulsechat.app>

# NEVER enable this in production; set true only for local testing without SMTP
ALLOW_DEV_RESET_CODE_PREVIEW=false
