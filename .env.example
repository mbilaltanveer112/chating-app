# Firebase AI Logic handles Gemini model requests via App Check attestation.
# No GEMINI_API_KEY is required in .env or BuildConfig.
#
# Optional TURN relay configuration for WebRTC voice/video calls across restrictive NATs:
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Node.js + MongoDB Auth Backend URL (from auth-backend-mongodb deployment)
AUTH_BACKEND_BASE_URL=
